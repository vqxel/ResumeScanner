# Anthropic Claude API Key (Optional - only needed if USE_MOCK_ANALYSIS=false)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Use mock analysis data (set to 'false' to use real Claude API)
# Default: true (uses mock data to avoid Vercel timeout)
# Set to 'false' only if you have fast hosting or Vercel Pro
USE_MOCK_ANALYSIS=true

# Use Python ATS parser (set to 'true' to enable pyresparser)
# Default: false (uses fast regex-based extraction)
# Set to 'true' only if you have Python dependencies installed
USE_PYTHON_ATS=false

# Optional: Node Environment
NODE_ENV=development
